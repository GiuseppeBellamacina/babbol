<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="it.babbol.app"
    android:versionCode="15"
    android:versionName="1.5.0">

    <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="34" />

    <!-- Login, sincronizzazione dei progressi e aggiornamento dei contenuti (Supabase). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Aggiornamento dall'app: scarica la nuova versione da GitHub e apre l'installatore di sistema. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Promemoria di studio (notifiche locali, programmabili e disattivabili dal Profilo). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Da Android 11 (API 30) i servizi di voce vanno dichiarati per poterli usare. -->
    <queries>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
        <intent><action android:name="android.speech.action.RECOGNIZE_SPEECH" /></intent>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="true"
        android:supportsRtl="true">

        <!-- Passa all'installatore l'APK scaricato (vedi UpdateProvider). -->
        <provider
            android:name=".UpdateProvider"
            android:authorities="it.babbol.app.updates"
            android:exported="false"
            android:grantUriPermissions="true" />

        <receiver android:name=".ReminderReceiver" android:exported="false" />
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|smallestScreenSize|screenLayout|uiMode|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Link nelle email di conferma registrazione / recupero password: babbol://auth-callback#... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="babbol" android:host="auth-callback" />
            </intent-filter>
        </activity>
    </application>
</manifest>
